{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartcommunitylabdhub.it/compliance/schemas/ProjectComplianceSpec",
  "title": "ProjectComplianceSpec",
  "description": "Compliance extension for a project entity (kind: ai-compliance, appliesTo: project).",
  "type": "object",
  "allOf": [
    {
      "$ref": "ComplianceSpec.json"
    }
  ],
  "properties": {
    "domain": {
      "$ref": "DomainDescriptor.json"
    },
    "ai_task": {
      "type": "string",
      "enum": [
        "CLASSIFICATION",
        "REGRESSION",
        "RANKING",
        "RECOMMENDATION",
        "GENERATION",
        "DETECTION",
        "FORECASTING",
        "CONTROL",
        "DECISION_SUPPORT",
        "OTHER"
      ]
    },
    "ai_task_value": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "deployment": {
      "type": "string",
      "enum": [
        "EDGE",
        "PREMISE",
        "CLOUD",
        "EMBEDDED"
      ]
    },
    "context": {
      "$ref": "ComplianceContext.json"
    }
  },
  "required": [
    "domain",
    "ai_task",
    "goal"
  ]
}