# Copy to .env. Model names are LiteLLM model ids (e.g. the alias exposed by the LiteLLM gateway).
STRUCTURED_MODEL=
COORDINATOR_MODEL=

# Optional per-agent overrides (legacy names still accepted).
# PROJECT_CONTEXT_AGENT_MODEL_NAME=
# DATA_ANALYSIS_AGENT_MODEL_NAME=
# MODEL_ANALYSIS_AGENT_MODEL_NAME=
# ROOT_AGENT_MODEL_NAME=

# LiteLLM gateway (optional; LiteLLM also reads provider env vars directly).
# LLM_API_BASE=http://localhost:4000
# LLM_API_KEY=

# Gemini-only thinking budget (tokens); leave unset for other providers.
# STRUCTURED_THINKING_BUDGET=
# COORDINATOR_THINKING_BUDGET=

# Optional. Leave unset if the selected model does not support temperature.
# STRUCTURED_TEMPERATURE=0.2

# ADK runner limits.
# MAX_CONCURRENCY=4
# REQUEST_TIMEOUT_S=120
# MAX_VALIDATION_RETRIES=2

# DH platform (read by the digitalhub SDK); compliance specifications are stored as entity extensions.
# DHCORE_ENDPOINT=https://core.example.org
# DHCORE_ACCESS_TOKEN=          # or DHCORE_PERSONAL_ACCESS_TOKEN / DHCORE_USER + DHCORE_PASSWORD
# DH_PROJECT=my-project         # project of the datasets and models referred to by name

# Optional overrides. OKF_PATH defaults to the packaged bundle; workspace defaults to cwd.
# OKF_PATH=/path/to/okf
# COMPLIANCE_WORKSPACE=.
