# OpenAI-compatible endpoint
# Works with: OpenAI, Azure OpenAI, GitHub Models, Ollama, LM Studio, vLLM, etc.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Optional: override the base URL for non-OpenAI endpoints
# OPENAI_BASE_URL=https://models.inference.ai.azure.com  # GitHub Models (use GitHub PAT as key)
# OPENAI_BASE_URL=http://localhost:11434/v1               # Ollama
# OPENAI_BASE_URL=http://localhost:1234/v1                # LM Studio

# OKF bundle path (defaults to ../../../okf relative to config.py)
# OKF_BUNDLE_PATH=/absolute/path/to/okf

# Local JSON data store (defaults to data/ inside the compliance_agent package)
# DATA_PATH=/absolute/path/to/data

# Logging — only agent.tools logs at this level; all other loggers are silent above WARNING
LOG_LEVEL=INFO

# Agent settings
AGENT_MAX_ITERATIONS=20
AGENT_VERBOSE=true

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit backend
API_BASE_URL=http://localhost:8000
